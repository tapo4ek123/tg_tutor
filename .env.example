# Create a bot with @BotFather. Never commit the real .env.
TELEGRAM_BOT_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REASONING_EFFORT=low
DATABASE_PATH=data/tutor.sqlite3
DEFAULT_TIMEZONE=Europe/Moscow
# Recommended for a personal deployment. Empty = open to all Telegram users.
# Comma-separated numeric Telegram user IDs, e.g. 12345678,87654321.
ALLOWED_USER_IDS=
MAX_REQUESTS_PER_HOUR=30
REMINDER_POLL_SECONDS=30
HEARTBEAT_PATH=data/heartbeat

# Global application budget; resets at midnight in this timezone.
DAILY_BUDGET_USD=3
BUDGET_TIMEZONE=Europe/Moscow
BUDGET_DATABASE_PATH=data/budget.sqlite3
EVAL_REPORT_DIR=evals/runs
# DeepSeek Flash peak USD per 1M tokens: conservative ceiling, off-peak bills less.
# Official pricing: https://api-docs.deepseek.com/quick_start/pricing/
LLM_PRICE_MODEL=deepseek-flash
LLM_INPUT_USD_PER_MILLION=0.30
LLM_CACHED_USD_PER_MILLION=0.006
LLM_OUTPUT_USD_PER_MILLION=1.20
LLM_PRICE_MULTIPLIER=1
